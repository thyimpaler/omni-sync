# The Node service. Every one of these is required at boot except META_GRAPH_URL:
# missing variables fail the process rather than defaulting to something plausible.

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase → Settings → Database → Connection string (session pooler).
# The service connects as service_role and is not constrained by RLS.
DATABASE_URL=postgres://postgres:password@localhost:5432/omnisync

# Meta app → Settings → Basic → App secret. Every webhook delivery is verified
# against it.
META_APP_SECRET=your-app-secret

# Chosen by you, then entered into the Meta webhook subscription form.
META_VERIFY_TOKEN=some-long-random-string

# Supabase → Settings → API → JWT secret. Authenticates an agent's session on
# the reply endpoint.
SUPABASE_JWT_SECRET=your-jwt-secret

# Leave unset until Meta app review is through: outbound messages are then
# recorded rather than sent.
# META_GRAPH_URL=https://graph.facebook.com/v21.0
# META_ACCESS_TOKEN=
