# Copy to .env.local and fill in. Production builds fail fast if any of these
# are missing; development falls back to demo values with a console warning.

# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The Node service — webhooks, the SLA engine and outbound sending. Run it from
# server/ (it has its own .env.example); this is where the client reaches it.
VITE_API_BASE=http://localhost:3001/api
