{
  "printWidth": 110,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": [
        "*.json",
        "*.yml",
        "*.yaml",
        "*.md",
        "eslint.config.js",
        "vite.config.ts",
        "playwright.config.ts"
      ],
      "options": { "tabWidth": 2 }
    }
  ]
}
